{
  "name": "hk-city-map",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 4731",
    "build": "next build && node scripts/migrate.mjs",
    "start": "next start --hostname 0.0.0.0 --port 4731",
    "test": "tsx --test src/*.test.ts src/cache/*.test.ts",
    "network": "python3 scripts/build_network.py",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@fontsource/noto-sans-tc": "^5.3.1",
    "@vinext/cloudflare": "^1.4.0",
    "maplibre-gl": "^5.24.0",
    "next": "^15.5.29",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-rc.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-rc.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
